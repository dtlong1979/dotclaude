{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/daily-pull.sh\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Đồng bộ ~/.claude (pull hằng ngày)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/push-sync.sh\" 1800",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/push-sync.sh\" 0",
            "shell": "bash",
            "async": true
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
