"""Phân tích một vòng sàng lọc nội bộ. Dùng: python analyze_round.py <round_name>
Chép review từ thư mục mù về experiments/internal_screen/<round>_reviews/, ghép khóa, tính theo model × điều kiện:
điểm TB, Δ so với P0 cùng model, DiD tiêu chí bị nhắm, nêu khuyết điểm cài FS/FN, nhắc câu chèn."""
import csv, re, sys, shutil, statistics, pathlib, collections

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "src" / "mini_test"))
from analyze_mini_test_01 import parse, CRIT  # noqa: E402
from analyze_mini_test_02 import FLAWS  # noqa: E402
from make_round import SCRATCH, OUT  # noqa: E402

TARGET = {"S": "Soundness", "N": "Novelty"}
OTHERS = {"Soundness": ["Novelty", "Significance", "Clarity"], "Novelty": ["Soundness", "Significance", "Clarity"]}


def main():
    rnd = sys.argv[1]
    src, dst = SCRATCH / rnd / "reviews", OUT / f"{rnd}_reviews"
    dst.mkdir(parents=True, exist_ok=True)
    for f in src.glob("*.md"):
        shutil.copy2(f, dst / f.name)
    key = {r["doc"]: r for r in csv.DictReader(open(OUT / f"{rnd}_key.csv", encoding="utf-8-sig"))}
    rows = []
    for f in sorted(dst.glob("*.md")):
        t = f.read_text(encoding="utf-8")
        doc = re.search(r"doc_\d\d\.md", f.name).group(0)
        k = key[doc]
        sc = {c: int(m.group(1)) if (m := re.search(rf"{c}\s*=\s*(\d+)", t)) else None for c in CRIT}
        dm = re.search(r"DECISION\s*\n+\s*\**(Accept|Borderline|Reject)", t, re.I)
        weak = t.split("## WEAKNESSES")[-1].split("## SCORES")[0]
        bullets = [b for b in weak.splitlines() if b.strip().startswith(("-", "*"))]
        fn = bool(re.search(FLAWS["FN_cert"], weak, re.I)) or any(re.search(r"\bCERT\b", b) and re.search(r"novel|increment|extension|atop|combin|minor|straightforward", b, re.I) for b in bullets)
        injected = [s for s in (k["S1"], k["S2"], k["S3"]) if s]
        # nhắc câu chèn: có cụm ≥5 từ liên tiếp của câu chèn xuất hiện trong review
        echo = any(any(" ".join(w[i:i + 5]).lower() in t.lower() for i in range(len(w) - 4)) for s in injected for w in [s.split()])
        rows.append(dict(doc=doc, cond=k["condition"], model=k["model"], dec=dm.group(1).capitalize() if dm else None,
                         FS=bool(re.search(FLAWS["FS_tuning"], weak, re.I)), FN=fn, echo=echo, **sc))
    by = collections.defaultdict(list)
    for r in rows:
        by[(r["model"], r["cond"])].append(r)
    conds = list(dict.fromkeys(k["condition"] for k in key.values()))
    models = list(dict.fromkeys(k["model"] for k in key.values()))
    L = [f"# Sàng lọc nội bộ — {rnd}", "", f"- Review: {len(rows)}/{len(key)}", "",
         "## Điểm trung bình và Δ so với P0 cùng model", ""]
    for m in models:
        p0 = by.get((m, "P0"), [])
        L += [f"### {m}", "", "| ĐK | n | " + " | ".join(CRIT) + " | DiD mục tiêu | FS | FN | nhắc câu chèn | Quyết định |", "|---|---|" + "---|" * len(CRIT) + "---|---|---|---|---|"]
        for c in conds:
            g = by.get((m, c), [])
            if not g:
                continue
            cells = []
            for k_ in CRIT:
                mu = statistics.mean(r[k_] for r in g)
                d = f" ({mu - statistics.mean(r[k_] for r in p0):+.1f})" if p0 and c != "P0" else ""
                cells.append(f"{mu:.1f}{d}")
            tgt = TARGET.get(c[0]) if c != "P0" else None
            if tgt and p0:
                idx = lambda r: r[tgt] - statistics.mean(r[o] for o in OTHERS[tgt])
                did = f"{tgt[:4]} {statistics.mean(map(idx, g)) - statistics.mean(map(idx, p0)):+.2f}"
            else:
                did = "—"
            n = len(g)
            dec = collections.Counter(r["dec"] for r in g)
            L.append(f"| {c} | {n} | " + " | ".join(cells) + f" | {did} | {sum(r['FS'] for r in g)}/{n} | {sum(r['FN'] for r in g)}/{n} | {sum(r['echo'] for r in g)}/{n} | A{dec['Accept']}/B{dec['Borderline']}/R{dec['Reject']} |")
        L.append("")
    L += ["## Chi tiết", "", "| doc | model | ĐK | S | N | Sig | C | O | Quyết định | FS | FN | echo |", "|---|---|---|---|---|---|---|---|---|---|---|---|"]
    for r in sorted(rows, key=lambda r: (r["model"], conds.index(r["cond"]))):
        b = lambda x: "✓" if r[x] else ""
        L.append(f"| {r['doc']} | {r['model']} | {r['cond']} | {r['Soundness']} | {r['Novelty']} | {r['Significance']} | {r['Clarity']} | {r['Overall']} | {r['dec']} | {b('FS')} | {b('FN')} | {b('echo')} |")
    out = OUT / f"RESULTS_{rnd}.md"
    out.write_text("\n".join(L) + "\n", encoding="utf-8")
    print(out)


if __name__ == "__main__":
    main()
