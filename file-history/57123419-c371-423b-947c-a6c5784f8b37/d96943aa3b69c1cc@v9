STRIP_KEYWORDS = {"help", "description", "epilog"}


def strip(source: str, defaults: dict) -> str:
    """Drop comments, docstrings and argparse help text; apply the paper's defaults."""
    tree = ast.parse(source)
    for node in ast.walk(tree):
        if isinstance(node, (ast.Module, ast.ClassDef, ast.FunctionDef, ast.AsyncFunctionDef)):
            body = node.body
            if (body and isinstance(body[0], ast.Expr)
                    and isinstance(body[0].value, ast.Constant)
                    and isinstance(body[0].value.value, str)):
                node.body = body[1:] or [ast.Pass()]
        if isinstance(node, ast.Call):
            node.keywords = [k for k in node.keywords if k.arg not in STRIP_KEYWORDS]
            if (defaults and isinstance(node.func, ast.Attribute)
                    and node.func.attr == "add_argument" and node.args
                    and isinstance(node.args[0], ast.Constant)
                    and node.args[0].value in defaults):
                value = defaults[node.args[0].value]
                node.keywords = [k for k in node.keywords if k.arg != "default"]
                node.keywords.append(ast.keyword(arg="default", value=ast.Constant(value)))
    return ast.unparse(ast.fix_missing_locations(tree)) + "\n"


def sanitise(obj):
    """Reduce local data paths to file names."""
    if isinstance(obj, dict):
        return {k: sanitise(v) for k, v in obj.items()}
    if isinstance(obj, list):
        return [sanitise(v) for v in obj]
    if isinstance(obj, str) and len(obj) > 2 and obj[1] == ":" and obj[2] in "/\\":
        return Path(obj.replace("\\", "/")).name
    return obj


def build(name: str, spec: dict) -> Path:
    dest = ROOT / spec["dest"]
    if dest.exists():
        shutil.rmtree(dest)
    for rel in spec["files"]:
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        source = (ROOT / rel).read_text(encoding="utf-8")
        target.write_text(strip(source, spec["defaults"].get(rel, {})), encoding="utf-8")
    for src, rel in spec["data"].items():
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        if src in spec["json_keep"]:
            data = json.loads((ROOT / src).read_text(encoding="utf-8"))
            keep = spec["json_keep"][src]
            data = {"entries": [{k: e[k] for k in keep if k in e} for e in data["entries"]]}
            target.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n",
                              encoding="utf-8")
        else:
            shutil.copyfile(ROOT / src, target)
    results = sorted({p for pattern in spec.get("results", ()) for p in ROOT.glob(pattern)})
    for src in results:
        rel = src.relative_to(ROOT).as_posix()
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        if src.suffix == ".json":
            data = sanitise(json.loads(src.read_text(encoding="utf-8")))
            target.write_text(json.dumps(data, indent=1) + "\n", encoding="utf-8")
        else:
            shutil.copyfile(src, target)
    for rel, src in spec.get("docs", {}).items():
        target = dest / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ROOT / src, target)
    lines = [f"# {name}", ""]
    lines += [f"- `{rel}`: {what}" for rel, what in spec["files"].items()]
    lines += [f"- `{rel}`: input data" for rel in spec["data"].values()]
    if results:
        lines.append(f"- `results/`: {len(results)} result files, per fold and per seed")
    lines += [f"- `{rel}`" for rel in spec.get("docs", {})]
    lines += [f"- {url}: {what}" for url, what in spec.get("external", {}).items()]
    if spec.get("environment"):
        lines += ["", "## Environment", ""]
        lines += [f"- {line}" for line in spec["environment"]]
    (dest / "README.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    (dest / "requirements.txt").write_text("\n".join(spec["requirements"]) + "\n",
                                           encoding="utf-8")
    print(f"{spec['dest']}: {len(spec['files'])} code files, {len(spec['data'])} data files, "
          f"{len(results)} result files")
    return dest


def main() -> None:
    for name, spec in PACKS.items():
        build(name, spec)


if __name__ == "__main__":
    main()
