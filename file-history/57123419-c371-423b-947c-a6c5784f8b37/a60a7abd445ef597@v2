#!/usr/bin/env python3
"""Figure for the FJCAI paper: the session-4 vs session-5 gap of every feature block.

Reads results/iemocap_session_gap_<encoder>.json (written by
experiments/iemocap_text_reextract.py --out). The released text, video and audio rows are
identical in every file, so they are taken from the first; each frozen encoder contributes
its own text row. Blue marks blocks fitted to IEMOCAP labels, orange blocks that never saw
them -- Word's theme accents 1 and 2, the only Office pair that passes the dataviz validator.

    python scripts/plot_gap_fig.py --out paper/fjcai/fig_gap.pdf
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import matplotlib

matplotlib.use("Agg")
import matplotlib.pyplot as plt  # noqa: E402

INK, MUTED, GRID = "#1f1f1f", "#6b6b6b", "#d9d9d9"
BLUE, ORANGE = "#4472C4", "#ED7D31"
ENCODERS = (("bert-base-uncased", "text, frozen BERT"),
            ("roberta-base", "text, frozen RoBERTa"),
            ("microsoft_deberta-v3-base", "text, frozen DeBERTa-v3"))
RELEASED = (("released CNN (2017, label-fit)", "text, released", BLUE),
            ("video (released 3D-CNN)", "video, released", BLUE),
            ("audio (unsupervised, reference)", "audio, released", ORANGE))


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--results", type=Path, default=Path("results"))
    ap.add_argument("--out", type=Path, default=Path("paper/fjcai/fig_gap.pdf"))
    args = ap.parse_args()

    runs = {tag: json.loads((args.results / f"iemocap_session_gap_{tag}.json").read_text())
            ["hold_out_session_4_vs_5"] for tag, _ in ENCODERS}
    first = runs[ENCODERS[0][0]]
    rows = [(label, first[key]["gap"] * 100, color) for key, label, color in RELEASED]
    for tag, label in ENCODERS:
        key = next(k for k in runs[tag] if k.startswith("frozen"))
        rows.append((label, runs[tag][key]["gap"] * 100, ORANGE))
    rows.sort(key=lambda r: r[1])

    plt.rcParams.update({"font.size": 7, "font.family": "serif", "axes.linewidth": 0.6})
    fig, ax = plt.subplots(figsize=(3.4, 2.0))
    ax.axvline(0, color=MUTED, lw=0.8, zorder=1)
    for y, (label, gap, color) in enumerate(rows):
        ax.plot([0, gap], [y, y], color=color, lw=2.2, solid_capstyle="round", zorder=2)
        ax.plot(gap, y, "o", color=color, ms=5, mec="white", mew=0.6, zorder=3)
        ax.annotate(f"{gap:+.1f}", (gap, y), xytext=(5 if gap >= 0 else -5, 0),
                    textcoords="offset points", ha="left" if gap >= 0 else "right",
                    va="center", fontsize=6.5, color=MUTED)
    ax.set_yticks(range(len(rows)), [r[0] for r in rows])
    ax.set_xlabel("session 4 $-$ session 5 accuracy (points)")
    ax.set_xlim(-18, 40)
    ax.tick_params(axis="y", pad=18)
    ax.grid(axis="x", color=GRID, lw=0.5)
    for s in ("top", "right", "left"):
        ax.spines[s].set_visible(False)
    ax.tick_params(axis="y", length=0)
    fig.tight_layout()
    args.out.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(args.out)
    fig.savefig(args.out.with_suffix(".png"), dpi=200)
    print("\n".join(f"{label:32s} {gap:+.2f}" for label, gap, _ in rows))
    print(f"written {args.out}")


if __name__ == "__main__":
    main()
