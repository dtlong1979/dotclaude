import importlib.util
import json
import re
from pathlib import Path


def load(n, f):
    s = importlib.util.spec_from_file_location(n, f)
    m = importlib.util.module_from_spec(s)
    s.loader.exec_module(m)
    return m


H = load("h", "experiments/mosi_mosei_headroom.py")
P = load("p", "experiments/paired_stats.py")
base = {c["corpus"]: c for c in json.load(open("results/headroom_mosi_mosei_20seeds.json"))}
mids = {**json.load(open("results/headroom_mosi_mid_20seeds.json")),
        **json.load(open("results/headroom_mosei_mid_20seeds.json"))}
R = {}
for name in ("MOSI", "MOSEI"):
    runs = dict(base[name]["runs"])
    runs["fused-mid (T+A+V)"] = mids[name]
    R[name] = runs

E, L, M = "fused-early (T+A+V)", "fused-late (T+A+V)", "fused-mid (T+A+V)"
mosei_mid = P.paired(R["MOSEI"][M]["acc"]["runs"], R["MOSEI"]["text"]["acc"]["runs"])
print("MOSEI mid-text acc:", P.fmt(mosei_mid), "p_t", round(mosei_mid["p_t"], 4))
p_mid = mosei_mid["p_permutation"]
p_mid_s = "p<0.001" if p_mid < 0.001 else f"p={p_mid:.2f}"

t = Path("paper/iceir/main.tex").read_text(encoding="utf-8")


def sub1(old, new):
    global t
    n = t.count(old)
    assert n == 1, f"expected 1, found {n}: {old[:70]!r}"
    t = t.replace(old, new)


def resub(pattern, new, flags=0):
    global t
    found = re.findall(pattern, t, flags)
    assert len(found) == 1, f"regex expected 1, found {len(found)}: {pattern[:60]!r}"
    t = re.sub(pattern, lambda _: new, t, flags=flags)


