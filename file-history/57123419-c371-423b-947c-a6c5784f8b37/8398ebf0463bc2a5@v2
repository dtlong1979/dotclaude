"""Rough word count of a LaTeX paper, to estimate LNCS pages."""
import re
import sys

t = open(sys.argv[1], encoding="utf-8").read()
t = t.replace("\\%", " PCT ")
t = re.sub(r"(?m)%.*$", "", t)                       # comments (escaped % already removed)
body = t.split("\\begin{abstract}", 1)[1].split("\\bibliographystyle", 1)[0]
tables = "".join(re.findall(r"\\begin\{table\}.*?\\end\{table\}", body, re.S))
abstract = body.split("\\end{abstract}", 1)[0]


def words(s: str) -> int:
    s = re.sub(r"\\(cite|ref|label|url)\{[^}]*\}", " X ", s)
    s = re.sub(r"\$[^$]*\$", " X ", s)
    s = re.sub(r"\\[a-zA-Z]+\*?", " ", s)
    s = re.sub(r"[{}\[\]&\\~]", " ", s)
    return len([w for w in s.split() if re.search(r"[A-Za-z0-9]", w)])


total, tw, aw = words(body), words(tables), words(abstract)
prose = total - tw
print(f"abstract {aw} words | body incl. tables {total} | tables {tw} | prose {prose}")
print(f"estimate: prose {prose / 430:.1f} pp at ~430 words/page, + 3 tables ~1.3 pp, "
      f"+ title/abstract ~0.8 pp, + references ~1.6 pp "
      f"= {prose / 430 + 1.3 + 0.8 + 1.6:.1f} pp")
