\toprule
Feature block & Ses.~4 & Ses.~5 & $g$ \\
\midrule
Released text (label-fit) & 90.45 & 59.36 & $+31.10$ \\
Released visual (label-fit) & 48.79 & 31.40 & $+17.38$ \\
Released audio (unsupervised) & 54.12 & 48.02 & $+6.10$ \\
\midrule
Frozen BERT-base & 56.83 & 63.98 & $-7.14$ \\
Frozen RoBERTa-base & 56.79 & 64.51 & $-7.72$ \\
Frozen DeBERTa-v3-base & 54.56 & 61.63 & $-7.07$ \\
\bottomrule
