\end{table}

\begin{figure}[t]
\centering
\includegraphics[width=\columnwidth]{fig_gap.pdf}
\caption{Session gap of each feature block (Table~\ref{tab:gap}). Blue: blocks whose
extractors were fitted to IEMOCAP labels; orange: blocks that never saw them.}
\label{fig:gap}
