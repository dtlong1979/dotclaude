"""Turn the raw MOSI/MOSEI runs into the numbers the paper quotes.

Reads results/headroom_mosi_mosei_{fixed,grid}.json and, when present,
results/headroom_mosi_mosei_mid.json, and reports for each corpus:

  * every configuration's mean +- sd over the shared seeds,
  * the majority-class floor and the best constant predictor,
  * H against the best of the fusion styles actually tried,
  * a paired t-test over seeds on the fused-minus-best-unimodal difference.

The t-test is paired because every configuration is run on the same seed list, so
the differences are matched; with five seeds it is a weak test, and it is reported
to bound the claim rather than to support it: the interesting outcome here is a
confidence interval that contains zero.
"""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import numpy as np
from scipy import stats

import importlib.util

_spec = importlib.util.spec_from_file_location(
    "headroom_main", Path(__file__).with_name("mosi_mosei_headroom.py"))
H = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(H)

METRICS = ("acc", "w_f1", "macro_f1", "kappa")


def load(path: Path):
    return json.loads(path.read_text()) if path.exists() else None


def report(corpus: dict, mid: dict | None, floors: dict) -> dict:
    name = corpus["corpus"]
    runs = dict(corpus["runs"])
    if mid:
        runs["fused-mid (T+A+V)"] = mid
    fusion = [k for k in runs if k.startswith("fused")]

    print(f"\n### {name}  "
          f"({corpus['n_train_utterances']} train / "
          f"{corpus['n_test_utterances']} test utterances, "
          f"{corpus['num_classes']} classes)")
    fl = corpus["majority_class_floor"]
    print(f"  floor (train-majority class {fl['majority_class']}): "
          f"acc={fl['acc']*100:.2f} wF1={fl['w_f1']*100:.2f} "
          f"macroF1={fl['macro_f1']*100:.2f} kappa={fl['kappa']:.3f}")
    if floors:
        best_c = max(floors["constant_predictors"],
                     key=lambda c: floors["constant_predictors"][c]["acc"])
        bc = floors["constant_predictors"][best_c]
        print(f"  best constant predictor (class {best_c}): "
              f"acc={bc['acc']*100:.2f} wF1={bc['w_f1']*100:.2f} "
              f"kappa={bc['kappa']:.3f}")

    print(f"  {'configuration':22s} {'acc':>14s} {'wF1':>14s} {'macroF1':>9s} "
          f"{'kappa':>7s}")
    for k, v in runs.items():
        print(f"  {k:22s} {v['acc']['mean']*100:8.2f}+-{v['acc']['std']*100:4.2f} "
              f"{v['w_f1']['mean']*100:8.2f}+-{v['w_f1']['std']*100:4.2f} "
              f"{v['macro_f1']['mean']*100:9.2f} {v['kappa']['mean']:7.3f}")

    out = {"corpus": name, "headroom": {}}
    for metric in METRICS:
        rec = H.headroom(runs, fusion, metric)
        best_uni, best_fus = rec["best_unimodal"], rec["best_fusion"]
        a = np.array(runs[best_fus][metric]["runs"])
        b = np.array(runs[best_uni][metric]["runs"])
        if len(a) == len(b) and len(a) > 1:
            d = a - b
            t, p = stats.ttest_rel(a, b)
            se = d.std(ddof=1) / np.sqrt(len(d))
            crit = stats.t.ppf(0.975, len(d) - 1)
            rec.update({"t": float(t), "p": float(p),
                        "ci95": [float(d.mean() - crit * se),
                                 float(d.mean() + crit * se)]})
        out["headroom"][metric] = rec
        scale = 100 if metric != "kappa" else 1
        ci = rec.get("ci95")
        ci_s = f"  95% CI [{ci[0]*scale:+.2f}, {ci[1]*scale:+.2f}], p={rec['p']:.3f}" \
            if ci else ""
        print(f"  H[{metric}] = {rec['H']*scale:+.2f}  ({best_fus} "
              f"{rec['fused_value']*scale:.2f} - {best_uni} "
              f"{rec['best_unimodal_value']*scale:.2f}){ci_s}"
              f"  [if selected on test: {rec['H_if_selected_on_test']*scale:+.2f}]")
    return out


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--results", type=Path, default=Path("results"))
    args = ap.parse_args()
    floors = load(args.results / "mosi_mosei_floors.json") or {}
    mid = load(args.results / "headroom_mosi_mosei_mid.json") or {}
    summary = {}
    for protocol in ("fixed", "grid"):
        data = load(args.results / f"headroom_mosi_mosei_{protocol}.json")
        if not data:
            continue
        print(f"\n## Protocol: {protocol}")
        summary[protocol] = [
            report(c, mid.get(c["corpus"]) if protocol == "fixed" else None,
                   floors.get(c["corpus"], {}))
            for c in data
        ]
    (args.results / "mosi_mosei_summary.json").write_text(json.dumps(summary, indent=2))
    print(f"\nwritten to {args.results / 'mosi_mosei_summary.json'}")


if __name__ == "__main__":
    main()
