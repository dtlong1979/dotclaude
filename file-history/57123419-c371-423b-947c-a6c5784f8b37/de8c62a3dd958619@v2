def rep(old, new, count=1):
    global t
    n = t.count(old)
    assert n == count, (n, old[:80])
    t = t.replace(old, new)


def rep_between(start, end, new):
    """Replace from start marker (inclusive) to end marker (exclusive)."""
    global t
    i = t.index(start)
    j = t.index(end, i)
    t = t[:i] + new + t[j:]


