import json
import re
from pathlib import Path

p = Path("paper/headroom.md")
t = p.read_text(encoding="utf-8")

summ = {c["corpus"]: c for c in json.load(open("results/mosi_mosei_summary_20seeds.json"))["fixed"]}
mac = summ["MOSEI"]["headroom"]["macro_f1"]
mac_s = f"{mac['H'] * 100:+.2f}"
mac_p = mac.get("p_permutation", mac.get("p"))
mac_p_s = "p < 0.001" if mac_p < 0.001 else f"p = {mac_p:.3f}"
print("MOSEI macro-F1 H", mac_s, mac_p_s)


def sub1(old, new):
    global t
    n = t.count(old)
    assert n == 1, f"expected 1, found {n}: {old[:70]!r}"
    t = t.replace(old, new)


def resub(pattern, new, flags=0):
    global t
    found = re.findall(pattern, t, flags)
    assert len(found) == 1, f"regex expected 1, found {len(found)}: {pattern[:60]!r}"
    t = re.sub(pattern, lambda _: new, t, flags=flags)


