MOI = '''def _tao_bo_tra_gv(db):
    """Bộ tra TÊN giảng viên trong file -> MÃ cán bộ. Trả (resolve, canh_bao).

    `resolve(ten, ma_lop, khoa_buoi)`; `khoa_buoi` = (thứ, tiết bắt đầu) để nhận ra mã đang gắn
    với chính buổi đó TRƯỚC khi bộ nhập xoá-chèn lại buổi. Mọi thứ đọc từ CSDL được chụp một
    lần ở đây, nên gọi được cả lúc XEM TRƯỚC lẫn lúc GHI THẬT và cho cùng một kết quả.

    LUẬT CỨNG: không bao giờ trả về một mã mang TÊN KHÁC với tên trong file. Bản cũ "kế thừa" GV
    lớp đang có khi tên trùng — tức lấy người khác tên — và đã gán nhầm buổi lý thuyết của thầy
    Trần Tiến Dũng cho thầy Nguyễn Đình Dũng (Lập trình Web .1/.2, 13/08/2026) mà không báo gì.
    """
    from .. import lop_sua as _ls
    ma_theo_ten = defaultdict(list)
    for ma, ten in db.execute(text("SELECT ma_cb, ho_ten FROM can_bo")).all():
        k = _nkey(ten)
        if k and ma not in ma_theo_ten[k]:
            ma_theo_ten[k].append(ma)
    cur = {r[0]: (r[1], r[2]) for r in db.execute(
        text("SELECT ma_lop_tc, ma_gv, ma_gv_th FROM lop_tin_chi")).all()}
    buoi_cu = defaultdict(dict)
    for c, thu, tt, g in db.execute(text(
            "SELECT ma_lop_tc, thu, tu_tiet, ma_gv FROM lich_hoc WHERE ma_gv IS NOT NULL")).all():
        buoi_cu[c][(thu, tt)] = g
    trung = {k: ds for k, ds in ma_theo_ten.items() if len(ds) > 1}
    song = {k: _ls.gv_dang_hoat_dong(db, ds) for k, ds in trung.items()}
    canh_bao = {}          # thông điệp -> None: giữ thứ tự, bỏ lặp

    def resolve(name, code, khoa_buoi=None):
        k = _nkey(name)
        if not k:                               # file không ghi tên -> giữ GV lớp đang có
            return cur.get(code, (None, None))[0]
        ds = ma_theo_ten.get(k)
        if not ds:
            canh_bao[f"{code}: “{name}” không có trong danh mục cán bộ — buổi để trống GV, "
                     f"cần gán tay."] = None
            return None                         # KHÔNG kế thừa người khác tên
        if k not in trung:
            return ds[0]
        # TRÙNG TÊN. (1) Mã đang gắn với CHÍNH buổi / lớp này mà mang đúng tên ấy -> giữ:
        #     giáo vụ đã chọn đúng người thì lần nhập sau không được đè.
        for m in (buoi_cu.get(code, {}).get(khoa_buoi), *cur.get(code, (None, None))):
            if m in ds:
                return m
        # (2) Người ĐANG HOẠT ĐỘNG, nếu lọc ra đúng một.
        if len(song[k]) == 1:
            return song[k][0]
        # (3) Không phân định được -> để trống và BÁO, tuyệt đối không đoán.
        canh_bao[f"{code}: “{name}” trùng tên {len(ds)} cán bộ ({', '.join(ds)}) — chưa xác "
                 f"định được người dạy, cần gán tay bằng MÃ cán bộ."] = None
        return None

    return resolve, canh_bao


def _after_apply(ctx, parsed):
    """Sau khi upsert lop_tin_chi: chuẩn hóa GV (lý thuyết / thực hành) theo tên, rồi THAY SẠCH
    buổi học theo từng lớp có trong file."""
    db = ctx.db
    sections = ctx.extra.get("sections", {})
    slots = ctx.extra.get("slots", [])
    from .. import lop_sua as _ls

    # Chụp TRƯỚC khi xoá-chèn buổi: bộ tra cần biết mã đang gắn với từng buổi cũ.
    resolve, canh_bao = _tao_bo_tra_gv(db)
    by_lop = defaultdict(list)
    for s in slots:
        by_lop[s["code"]].append(s)

    # 1) GV CẤP LỚP — lý thuyết lấy từ buổi KHÔNG phải P3x, thực hành từ buổi P3x. Bản cũ lấy
    #    tên ở DÒNG ĐẦU TIÊN của file bất kể loại buổi, nên GV thực hành bị đẩy lên ô lý thuyết.
    #    Chỉ GHI khi tra ra mã (KHÔNG xoá GV đang đúng khi file thiếu tên / tên không xác định).
    sua_gv = 0
    for code, sec in sections.items():
        ss = [x for x in by_lop.get(code, []) if x.get("gv_name")]
        lt = next((x for x in ss if not _ls.la_thuc_hanh(x.get("phong"))), None)
        th = next((x for x in ss if _ls.la_thuc_hanh(x.get("phong"))), None)
        g_lt = (resolve(lt["gv_name"], code, (lt["thu"], lt["tt"])) if lt
                else resolve(sec.get("_gv"), code))
        g_th = resolve(th["gv_name"], code, (th["thu"], th["tt"])) if th else None
        if g_lt:
            db.execute(text("UPDATE lop_tin_chi SET ma_gv=:g WHERE ma_lop_tc=:c"),
                       {"g": g_lt, "c": code})
            sua_gv += 1
        goc_lt = g_lt or cur_gv_lop(db, code)
        if g_th and g_th != goc_lt:             # thực hành do NGƯỜI KHÁC dạy -> ghi ô thực hành
            db.execute(text("UPDATE lop_tin_chi SET ma_gv_th=:g WHERE ma_lop_tc=:c"),
                       {"g": g_th, "c": code})
    ctx.report["dat_ma_gv"] = sua_gv

    # 2) THAY SẠCH buổi theo lớp: xóa buổi cũ của các lớp CÓ TRONG file, chèn lại từ file
    #    (lớp không có trong file -> không đụng). Bỏ buổi không có lịch tuần (đồ án/khóa luận).
    db.execute(text("ALTER TABLE lich_hoc ADD COLUMN IF NOT EXISTS ma_gv varchar"))
    ins = text("""INSERT INTO lich_hoc
        (ma_lop_tc, thu, ca_hoc, tu_tiet, den_tiet, tu_ngay, den_ngay, ma_phong, ma_gv)
        VALUES (:c,:thu,:ca,:tt,:dt,
                CAST(:tn AS DATE), CAST(:dn AS DATE), :ph, :gv)""")
    them_buoi = 0
    lui_th = 0
    from .. import lich_thuc_hanh as _th
    for code, ss in by_lop.items():
        # Buổi THỰC HÀNH (phòng máy P3x) lùi một tuần so với lý thuyết — tuần đầu chưa có gì
        # để thực hành. Làm ngay tại đây thay vì sửa tay sau mỗi lần nhập TKB.
        lui_th += _th.lui_khi_nhap(ss)
        db.execute(text("DELETE FROM lich_hoc WHERE ma_lop_tc=:c"), {"c": code})
        for s in ss:
            if not (s["thu"] and s["tt"]):
                continue   # không có lịch tuần cố định -> giữ lớp, không tạo buổi
            db.execute(ins, {"c": code, "thu": s["thu"], "ca": s["ca"], "tt": s["tt"],
                             "dt": s["dt"], "tn": s["tu_ngay"], "dn": s["den_ngay"],
                             "ph": s["phong"],
                             "gv": resolve(s["gv_name"], code, (s["thu"], s["tt"]))})
            them_buoi += 1
    ctx.report["thay_buoi"] = them_buoi
    ctx.report["lui_thuc_hanh"] = lui_th
    if canh_bao:
        ctx.report["gv_canh_bao"] = list(canh_bao)
'''
