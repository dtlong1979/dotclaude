# Xếp giải theo thứ hạng: nhóm có giải = hồ sơ hợp lệ đạt >= 70 điểm; trong nhóm này chia theo
# tỷ lệ định mức 20 : 25 : 40 (chung khảo : Ba : Khuyến khích), không tách các đề tài bằng điểm.
TY_LE = (20, 25, 40)


def _cat(ds, can):
    """Chọn số phần tử gần 'can' nhất mà không cắt ngang một nhóm bằng điểm."""
    if can <= 0 or not ds:
        return 0
    moc = [i for i in range(1, len(ds) + 1) if i == len(ds) or ds[i - 1][1] != ds[i][1]]
    return min(moc, key=lambda i: (abs(i - can), i))


def _xep_giai():
    co = sorted(((m, tong(m)) for m in D if m not in KHONG_DU_DK and tong(m) >= 70), key=lambda r: -r[1])
    n = len(co)
    k1 = _cat(co, round(n * TY_LE[0] / sum(TY_LE)))
    k2 = k1 + _cat(co[k1:], round(n * TY_LE[1] / sum(TY_LE)))
    g = {}
    for i, (m, _) in enumerate(co):
        g[m] = 'Vào vòng chung khảo' if i < k1 else 'Giải Ba' if i < k2 else 'Giải Khuyến khích'
    return g


def xep(t, ma=None):
    return GIAI.get(ma, 'Không đạt giải')


