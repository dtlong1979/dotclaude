def _fit(b, t):
    """Đưa tổng về t: chênh nhỏ dồn vào Kết quả; chênh lớn phân bổ theo khoảng trống."""
    v = list(b[:4])
    d = t - sum(b[:6])
    if abs(d) <= 3:
        v[3] += d
    else:
        s = 1 if d > 0 else -1
        for _ in range(abs(d)):
            if s > 0:
                i = max(range(4), key=lambda k: (_MAX[k] - v[k]) / _MAX[k])
            else:
                i = max(range(4), key=lambda k: (v[k] - _MIN[k]) / _MAX[k])
            v[i] += s
    return tuple(v) + (b[4], b[5])


def _base(m):
    b = list(BASE[m])
    b[4] = max(0, b[4] + HT_ADJ.get(m, 0))
    return tuple(b)


