# -*- coding: utf-8 -*-
"""Sinh 2 tệp phiếu từ mẫu Phụ lục 1 và Phụ lục 2."""
import copy, json, sys, re
import docx
from docx.enum.text import WD_BREAK
from docx.shared import Pt
from docx.oxml.ns import qn

sys.path.insert(0, '.')
import diem, nx_pl2, nx_pl1_a, nx_pl1_b, nx_pl1_c

PL1 = {**nx_pl1_a.PL1_A, **nx_pl1_b.PL1_B, **nx_pl1_c.PL1_C}
PL2 = nx_pl2.PL2
EX = json.load(open('excel.json', encoding='utf-8'))

HO_TEN = 'TS. Đinh Tuấn Long'
LINH_VUC = 'Khoa học tự nhiên'
HOI_DONG = '01'
NGAY = 'Hà Nội, ngày 12 tháng 9 năm 2026'
TICK, BOX = '■', '□'

T1 = r'D:/HĐ NCKH/3. Phụ lục 1. Phieu nhan xet - Gửi Thành viên HĐ.docx'
T2 = r'D:/HĐ NCKH/4. Phụ lục 2. Phieu đanh gia - Gửi thành viên HĐ.docx'


# ---------- tiện ích ----------
def dat_text(p, txt, dam=None):
    """Ghi lại toàn bộ nội dung đoạn, giữ định dạng của run đầu tiên."""
    if not p.runs:
        p.add_run('')
    r0 = p.runs[0]
    for r in p.runs[1:]:
        r._element.getparent().remove(r._element)
    r0.text = txt
    if dam is not None:
        r0.bold = dam
    return p


def them_doan_sau(p, txt, mau=None):
    """Chèn một đoạn mới ngay sau đoạn p, sao chép định dạng từ đoạn mẫu."""
    goc = mau if mau is not None else p
    moi = copy.deepcopy(goc._element)
    p._element.addnext(moi)
    np = docx.text.paragraph.Paragraph(moi, p._parent)
    dat_text(np, txt, dam=False)
    return np


def xoa(p):
    p._element.getparent().remove(p._element)


def stt_cua(ma):
    return int(EX.get(ma, {}).get('stt') or 0)


def ten_cua(ma):
    return str(EX.get(ma, {}).get('ten', '')).strip().replace('\n', ' ')


def ngat_trang(doc):
    p = doc.add_paragraph()
    p.add_run().add_break(WD_BREAK.PAGE)


def chep_than(nguon, dich):
    """Sao chép toàn bộ phần thân (trừ sectPr) của tài liệu nguồn vào cuối tài liệu đích."""
    for ch in nguon.element.body.iterchildren():
        if ch.tag == qn('w:sectPr'):
            continue
        dich.element.body.append(copy.deepcopy(ch))


def bat_dau(mau_path):
    """Tạo tài liệu rỗng giữ nguyên khổ giấy, lề và style của mẫu."""
    d = docx.Document(mau_path)
    for ch in list(d.element.body.iterchildren()):
        if ch.tag != qn('w:sectPr'):
            d.element.body.remove(ch)
    return d


# ---------- Phụ lục 1 ----------
def phieu_pl1(ma):
    d = docx.Document(T1)
    v = PL1[ma]
    tong = sum(diem.D[ma][:6])
    for p in d.paragraphs:
        t = p.text.strip()
        if t.startswith('Lĩnh vực:'):
            dat_text(p, f'Lĩnh vực: {LINH_VUC}')
        elif t.startswith('Hội đồng số:'):
            dat_text(p, f'Hội đồng số: {HOI_DONG}')
        elif t.startswith('1. Họ và tên'):
            dat_text(p, f'1. Họ và tên thành viên hội đồng: {HO_TEN}')
        elif t.startswith('2. Nhiệm vụ'):
            dat_text(p, f'2. Nhiệm vụ trong Hội đồng:        {BOX} Ủy viên            '
                        f'              {TICK} Ủy viên phản biện')
        elif t.startswith('3. Tên đề tài'):
            dat_text(p, f'3. Tên đề tài đề nghị xét tặng: {ten_cua(ma)}')
        elif t.startswith('4. Mã số đề tài'):
            dat_text(p, f'4. Mã số đề tài/ Số thứ tự đề tài: {ma} / STT {stt_cua(ma)}')
        elif t.startswith('a. Tổng quan'):
            dat_text(p, 'a. Tổng quan tình hình nghiên cứu và luận giải sự cần thiết '
                        'của vấn đề nghiên cứu: ' + v['a'])
        elif t.startswith('b. Nội dung nghiên cứu'):
            dat_text(p, 'b. Nội dung nghiên cứu: ' + v['b'])
        elif t.startswith('c. Phương pháp nghiên cứu'):
            dat_text(p, 'c. Phương pháp nghiên cứu: ' + v['c'])
        elif t.startswith('d. Kết quả nghiên cứu'):
            dat_text(p, 'd. Kết quả nghiên cứu: ' + v['d'])
        elif t.startswith('e. Hình thức trình bày'):
            dat_text(p, 'e. Hình thức trình bày báo cáo tổng kết đề tài: ' + v['e'])
        elif t.startswith('f. Có công bố khoa học'):
            dat_text(p, 'f. Có công bố khoa học từ kết quả nghiên cứu của đề tài, cụ thể: ' + v['f'])
        elif t.startswith('- Bài báo được đăng trên các tạp chí khoa học trong nước'):
            dat_text(p, '- Bài báo được đăng trên các tạp chí khoa học trong nước được tính điểm '
                        'của Hội đồng Giáo sư Nhà nước hoặc đăng trong kỷ yếu hội thảo, hội nghị '
                        'quốc gia, quốc tế có phản biện: ' + v['f1'])
        elif t.startswith('- Bài báo được đăng trên các tạp chí quốc tế'):
            dat_text(p, '- Bài báo được đăng trên các tạp chí quốc tế uy tín: ' + v['f2'])
        elif t.startswith('- Sáng chế'):
            dat_text(p, '- Sáng chế, giải pháp hữu ích, bản quyền tác giả, bản quyền tác phẩm,... '
                        'đã được chứng nhận: ' + v['f3'])
        elif t.startswith('7. Kết luận'):
            dat_text(p, '7. Kết luận của thành viên Hội đồng (Đánh giá chung theo các tiêu chí '
                        'nhận xét tại mục 6)')
            them_doan_sau(p, f'{v["kl"]} Tổng điểm đánh giá: {tong}/100 điểm.')
    for tb in d.tables:
        for row in tb.rows:
            for cell in row.cells:
                for p in cell.paragraphs:
                    t = p.text.strip()
                    if t.startswith('Hà Nội, ngày'):
                        dat_text(p, NGAY)
                    elif 'Ký, ghi rõ họ tên' in t:
                        them_doan_sau(p, '\n\n\n' + HO_TEN)
    return d


# ---------- Phụ lục 2 ----------
def phieu_pl2(ma):
    d = docx.Document(T2)
    v = diem.D[ma]
    tong = sum(v[:6])
    xg = diem.xep(tong)
    la_pb = ma in diem.PB
    for p in d.paragraphs:
        t = p.text.strip()
        if t.startswith('Lĩnh vực:'):
            dat_text(p, f'Lĩnh vực: {LINH_VUC}')
        elif t.startswith('Hội đồng số:'):
            dat_text(p, f'Hội đồng số: {HOI_DONG}')
        elif t.startswith('1. Họ và tên'):
            dat_text(p, f'1. Họ và tên thành viên hội đồng: {HO_TEN}')
        elif t.startswith('2. Nhiệm vụ'):
            uv, pb = (BOX, TICK) if la_pb else (TICK, BOX)
            dat_text(p, f'2. Nhiệm vụ trong Hội đồng:  {BOX} Chủ tịch     '
                        f'{uv} Ủy viên     {pb} Ủy viên phản biện')
        elif t.startswith('3. Tên đề tài'):
            dat_text(p, f'3. Tên đề tài đề nghị xét tặng: {ten_cua(ma)}')
        elif t.startswith('4. Mã số đề tài'):
            dat_text(p, f'4. Mã số đề tài/ Số thứ tự đề tài: {ma} / STT {stt_cua(ma)}')
    # mục 7: thay 6 dòng chấm bằng nội dung ý kiến
    cham = [p for p in d.paragraphs if set(p.text.strip()) <= {'.'} and len(p.text.strip()) > 20]
    if cham:
        dat_text(cham[0], PL2[ma])
        for p in cham[1:]:
            xoa(p)
    # mục 8: đánh dấu mức xếp giải
    for p in d.paragraphs:
        t = p.text
        if '□ Vào vòng chung khảo' in t:
            a = TICK if xg == 'Vào vòng chung khảo' else BOX
            b = TICK if xg == 'Giải Ba' else BOX
            dat_text(p, f'{a} Vào vòng chung khảo \t\t\t{b} Giải Ba', dam=True)
        elif '□ Giải Khuyến khích' in t:
            a = TICK if xg == 'Giải Khuyến khích' else BOX
            b = TICK if xg == 'Không đạt giải' else BOX
            dat_text(p, f'{a} Giải Khuyến khích \t\t\t{b} Không đạt giải', dam=True)
    # bảng điểm
    tb = d.tables[1]
    diem_o = {1: v[0], 2: v[1], 3: v[2], 4: v[3], 5: v[4], 6: v[5]}
    for r, val in diem_o.items():
        dat_text(tb.rows[r].cells[3].paragraphs[0], str(val), dam=True)
    for r in (7, 8, 9):
        dat_text(tb.rows[r].cells[3].paragraphs[0], '-')
    dat_text(tb.rows[10].cells[3].paragraphs[0], str(tong), dam=True)
    # ngày tháng + chữ ký
    for t_ in d.tables:
        for row in t_.rows:
            for cell in row.cells:
                for p in cell.paragraphs:
                    if p.text.strip().startswith('Hà Nội, ngày'):
                        dat_text(p, NGAY)
                    elif 'Ký, ghi rõ họ tên' in p.text:
                        them_doan_sau(p, '\n\n\n' + HO_TEN)
    return d


if __name__ == '__main__':
    thu_tu = sorted(diem.D, key=stt_cua)

    # --- Tệp Phụ lục 1: 19 đề tài phản biện ---
    pb = [m for m in thu_tu if m in diem.PB]
    out1 = bat_dau(T1)
    for i, ma in enumerate(pb):
        if i:
            ngat_trang(out1)
        chep_than(phieu_pl1(ma), out1)
    f1 = r'D:\HĐ NCKH\7. Phu luc 1 - Phieu nhan xet (19 de tai phan bien) - TS Dinh Tuan Long.docx'
    out1.save(f1)
    print('Đã lưu', f1, '|', len(pb), 'phiếu')

    # --- Tệp Phụ lục 2: toàn bộ 59 đề tài ---
    out2 = bat_dau(T2)
    for i, ma in enumerate(thu_tu):
        if i:
            ngat_trang(out2)
        chep_than(phieu_pl2(ma), out2)
    f2 = r'D:\HĐ NCKH\8. Phu luc 2 - Phieu danh gia (59 de tai) - TS Dinh Tuan Long.docx'
    out2.save(f2)
    print('Đã lưu', f2, '|', len(thu_tu), 'phiếu')
