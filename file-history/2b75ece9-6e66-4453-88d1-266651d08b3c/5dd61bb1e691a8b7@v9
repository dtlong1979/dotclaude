def bo_ghi_chu(s):
    """Bỏ nhãn 'Ghi chú:'; bỏ hẳn ghi chú thời điểm thông thường, giữ câu có ý nghĩa."""
    def thay(m):
        nd = m.group(1).strip()
        if re.search(r'(trước thời gian|sau thời điểm|không ghi năm)', nd):
            return ' ' + nd[0].upper() + nd[1:]
        return ''
    return re.sub(r'\s*Ghi chú:\s*([^.]*\.)', thay, s).strip()


def y_kien_pl2(ma):
    than = bo_ghi_chu(bo_do_dai(ma, nx_pl2.PL2.get(ma) or PL1[ma]['kl']))
    note = THOI_DIEM.get(ma, '')
    if note.startswith('Công bố năm 2024') and 'Công bố năm 2024' in than:
        than = than.replace('Công bố năm 2024', 'Công bố năm 2024, trước thời gian thực hiện đề tài', 1)
    elif note and note not in than:
        than = f'{than} {note}'
    if ma in KHONG_CHE_TEN:
        return cau_che_ten(ma)
    than = bo_cau_nam(than)
    if ghi_nhan(ma):
        than = f'{than} {ghi_nhan(ma)}'
    if ma in KHONG_DU_DK_NAM:
        than = f'{than} {CAU_NAM}'
    return than


def stt_cua(ma):
    return int(EX.get(ma, {}).get('stt') or 0)


def ten_cua(ma):
    return str(EX.get(ma, {}).get('ten', '')).strip().replace('\n', ' ')


def ngat_trang(doc):
    """Kết thúc phiếu bằng ngắt section kiểu trang mới: phiếu sau luôn bắt đầu ở đầu trang,
    giữ nguyên khổ giấy và lề của mẫu."""
    sp = doc.element.body.find(qn('w:sectPr'))
    s = copy.deepcopy(sp)
    for t in s.findall(qn('w:type')):
        s.remove(t)                      # mặc định của Word là nextPage
    p = OxmlElement('w:p')
    ppr = OxmlElement('w:pPr')
    ppr.append(s)
    p.append(ppr)
    sp.addprevious(p)


def chep_than(nguon, dich):
    """Chép thân phiếu vào TRƯỚC sectPr cuối của tài liệu đích."""
    sp = dich.element.body.find(qn('w:sectPr'))
    for ch in nguon.element.body.iterchildren():
        if ch.tag != qn('w:sectPr'):
            sp.addprevious(copy.deepcopy(ch))


def bat_dau(mau_path):
    d = docx.Document(mau_path)
    for ch in list(d.element.body.iterchildren()):
        if ch.tag != qn('w:sectPr'):
            d.element.body.remove(ch)
    return d


def ky_ten(d):
    for tb in d.tables:
        for row in tb.rows:
            for cell in row.cells:
                for p in cell.paragraphs:
                    t = p.text.strip()
                    if t.startswith('Hà Nội, ngày'):
                        dat_text(p, NGAY)
                    elif 'Ký, ghi rõ họ tên' in t:
                        them_doan_sau(p, '\n\n\n' + HO_TEN)


def dau_phieu(p, t, ma, nhiem_vu):
    if t.startswith('Lĩnh vực:'):
        dat_text(p, f'Lĩnh vực: {LINH_VUC}')
    elif t.startswith('Hội đồng số:'):
        dat_text(p, f'Hội đồng số: {HOI_DONG}')
    elif t.startswith('1. Họ và tên'):
        dat_text(p, f'1. Họ và tên thành viên hội đồng: {HO_TEN}')
    elif t.startswith('2. Nhiệm vụ'):
        dat_text(p, nhiem_vu)
    elif t.startswith('3. Tên đề tài'):
        dat_text(p, f'3. Tên đề tài đề nghị xét tặng: {ten_cua(ma)}')
    elif t.startswith('4. Mã số đề tài'):
        dat_text(p, f'4. Mã số đề tài/ Số thứ tự đề tài: {ma} / STT {stt_cua(ma)}')
    else:
        return False
    return True


