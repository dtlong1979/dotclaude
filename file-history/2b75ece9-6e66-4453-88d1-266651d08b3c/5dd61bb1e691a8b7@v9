def ket_luan(ma):
    """Câu tổng điểm và đề nghị xếp giải sinh từ bảng điểm để luôn khớp."""
    t = diem.tong(ma)
    tong_diem = f'Tổng điểm: {t}/100.'
    if ma in KHONG_CHE_TEN:                       # chỉ một câu, rồi tổng điểm
        return f'{cau_che_ten(ma)} {tong_diem}'
    than = bo_cau_nam(bo_do_dai(ma, PL1[ma]['kl'].strip())) if ma in PL1 else ''
    if ghi_nhan(ma):
        than = f'{than} {ghi_nhan(ma)}'
    chot = CAU_NAM if ma in KHONG_DU_DK_NAM else DE_NGHI[diem.xep(t, ma)]
    return f'{than} {chot} {tong_diem}'.strip()     # tổng điểm luôn là câu cuối


TRANG_MIN, TLTK_MIN = 40, 15      # báo cáo dưới 40 trang hoặc dưới 15 tài liệu tham khảo là bất thường


def bat_thuong(ma):
    trang, tltk = diem.D[ma][6], diem.D[ma][7]
    return (0 < trang < TRANG_MIN) or tltk < TLTK_MIN


def bo_do_dai(ma, s):
    """Bỏ các mệnh đề nêu dung lượng báo cáo khi báo cáo bình thường."""
    if bat_thuong(ma):
        return s
    s = re.sub(r'[;,]\s*báo cáo \d+ trang(, \d+ tài liệu tham khảo)?( chưa tương xứng[^;.]*)?(?=[;.])', '', s)
    s = re.sub(r'[;,]\s*báo cáo tương xứng với (các )?công bố( kèm theo)?', '', s)
    out = []
    for c in re.split(r'(?<=\.)\s+', s):
        m = re.match(r'Báo cáo (tổng kết )?\d+ trang(, \d+ tài liệu tham khảo)?(?P<rest>.*)$', c)
        if m:
            giu = [p.strip(' .') for p in re.split(r'[,;]', m.group('rest'))]
            giu = [p for p in giu if p and not re.match(r'(chưa |không )?(tương xứng|bao quát|trình bày phù hợp|đạt yêu cầu|bố cục|đủ)', p)]
            if giu:
                out.append('Báo cáo ' + ', '.join(giu) + '.')
            continue
        out.append(c)
    return ' '.join(x for x in out if x.strip())


