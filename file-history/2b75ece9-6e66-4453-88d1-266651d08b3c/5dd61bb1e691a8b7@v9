def ghi_nhan(ma):
    """Các ghi nhận bổ sung đưa vào phiếu: văn phong, che tên (phần bao trùm công bố chỉ ghi ở Excel)."""
    g = []
    if ma in VANPHONG:
        g.append(VANPHONG[ma][1])
    if ma in ANDANH and ANDANH[ma][0] == 'B':
        g.append(ANDANH[ma][1])
    return ' '.join(g)


def cau_che_ten(ma):
    """Hồ sơ không che tên: chỉ một câu, nêu đúng tài liệu lộ tên."""
    chi_tiet = ANDANH[ma][1].split(':', 1)[1].strip().rstrip('.')
    return f'Hồ sơ không che tên theo quy định: {chi_tiet}.'


CAU_NAM = 'Hồ sơ không có công bố hoặc ứng dụng trong năm 2025 theo quy định.'


def bo_cau_nam(s):
    """Bỏ các câu rải rác về điều kiện năm 2025 để chỉ còn một câu chuẩn."""
    s = re.sub(r'\s*Không có công bố hoặc ứng dụng( hợp lệ)? trong năm 2025[^.]*\.', '', s)
    s = re.sub(r'\s*Không có công bố; thời gian ứng dụng năm 2026\.', ' Thời gian ứng dụng năm 2026.', s)
    return s.strip()

