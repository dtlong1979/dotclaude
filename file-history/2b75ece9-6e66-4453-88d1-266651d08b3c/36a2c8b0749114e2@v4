def sach(s):
    out = []
    for d in str(s).splitlines():
        d = d.strip().lstrip('-').strip()
        for k in ('⭐', '⚠', '**', '→'):
            d = d.replace(k, '')
        d = ' '.join(d.split())
        if d and not d.startswith('TQ '):
            out.append('• ' + d)
    return '\n'.join(out)


def tieu_de(ws, dong, cot, mau='305496'):
    for j, h in enumerate(cot, 1):
        c = ws.cell(row=dong, column=j, value=h)
        c.font = Font(bold=True, color='FFFFFF')
        c.fill = PatternFill('solid', fgColor=mau)
        c.alignment = Alignment(horizontal='center', vertical='center', wrap_text=True)
        c.border = VIEN
    ws.row_dimensions[dong].height = 36


def o(ws, r, c, v, giua=False, dam=False, bao=True):
    x = ws.cell(row=r, column=c, value=v)
    x.border = VIEN
    x.alignment = Alignment(vertical='top', wrap_text=bao, horizontal='center' if giua else 'left')
    if dam:
        x.font = Font(bold=True)
    return x


