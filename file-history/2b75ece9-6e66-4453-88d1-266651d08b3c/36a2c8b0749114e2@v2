def sach(s):
    """Rút gọn lý do chấm thành vài gạch đầu dòng, bỏ ký tự đánh dấu."""
    out = []
    for d in str(s).splitlines():
        d = d.strip().lstrip('-').strip()
        for k in ('⭐', '⚠', '**', '→'):
            d = d.replace(k, '')
        d = ' '.join(d.split())
        if d and not d.startswith('TQ '):
            out.append('• ' + d)
    return '\n'.join(out)


