* { box-sizing: border-box; }
html, body { margin: 0; background: var(--qcv-c-bg); color: var(--qcv-c-fg); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
.site-header { display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; background: #fff; border-bottom: 1px solid #eee; }
.site-header__brand { font-weight: 700; color: var(--qcv-c-fg); text-decoration: none; }
.site-header__nav a { margin-left: 18px; color: var(--qcv-c-fg); text-decoration: none; }
.site-footer { padding: 32px 24px; background: #f3efe9; margin-top: 40px; }
.site-footer__form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
.site-footer__form input { padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
.site-footer__form button { padding: 8px 14px; border: 0; border-radius: 4px; background: var(--qcv-c-primary); color: #fff; }

/* ---------------------------------------------------------------------------------------------------------------
   VÙNG TOÀN SITE `floating` — HD-03 6.2, bốn luật. Đây là CSS của CORE, không phải của block:
   luật 1 nói ngăn xếp nổi là MỘT phần tử do bộ kết xuất dựng, và block trong vùng không tự đặt `position: fixed`
   (lint 11 của `qcv:kiem-blade` chặn). Sản xuất gộp tệp này vào `site.css`.
   `--qcv-floating-h` (chiều cao ngăn xếp) và `--qcv-bottom-bar-h` (chiều cao thanh dính đáy) do `floating.js` đo
   và đặt trên `:root` — luật 2. Giá trị dự phòng 0px để trang vẫn đúng khi JS chưa chạy hoặc bị chặn.
   --------------------------------------------------------------------------------------------------------------- */
.qcv-floating { position: fixed; z-index: 60; right: 12px; bottom: calc(var(--qcv-bottom-bar-h, 0px) + 12px);
  display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
/* Luật 2 — thu gọn về MỘT nút khi trang có thanh dính đáy (`collapseWithBottomBar`, mặc định bật) */
.qcv-floating--gon.is-co-thanh-day > * > *:not(:first-child) { display: none; }
/* Luật 3 — nội dung chừa chỗ đúng chiều cao ngăn xếp; thiếu dòng này thì phần tử nổi che chữ ở cuối trang và
   phép kiểm thứ tư của cổng phần tử (ngưỡng 0 %) chặn. */
body { padding-bottom: calc(var(--qcv-floating-h, 0px) + 24px); }
.tnk { display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
.tnk__nut { display: inline-block; padding: 10px 14px; border-radius: var(--radius); background: var(--color-primary);
  color: var(--color-on-primary); text-decoration: none; font-size: var(--text-sm); }
.lk { padding: 16px 24px; }
.lk__ctx { font-weight: 700; margin: 0 0 4px; }
.lk__mota, .lk__trong { color: var(--color-muted); margin: 0; }
