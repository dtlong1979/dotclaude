// Nghi vấn của lượt trước: một số ảnh sản phẩm "không hiện" trên /san-pham. Đo bằng số, không bằng mắt:
// bao nhiêu thẻ <img>, bao nhiêu ảnh THẬT SỰ tải được (naturalWidth > 0), và cái nào hỏng.
import { chromium } from 'playwright-core';
const [ip] = process.argv.slice(2);
const browser = await chromium.launch({
  executablePath: '/usr/bin/chromium-browser',
  args: [`--host-resolver-rules=MAP qcv2-mau.localhost ${ip}`, '--no-sandbox', '--disable-gpu'],
});
for (const url of ['/san-pham', '/', '/bo-suu-tap']) {
  const page = await browser.newPage({ viewport: { width: 1280, height: 900 }, locale: 'vi-VN' });
  const hong404 = [];
  page.on('response', (r) => { if (r.status() >= 400) hong404.push(`${r.status()} ${r.url().slice(-60)}`); });
  await page.goto(`http://qcv2-mau.localhost:8081${url}`, { waitUntil: 'networkidle' });
  await page.evaluate(async () => {
    for (let y = 0; y < document.body.scrollHeight; y += 400) { scrollTo(0, y); await new Promise((r) => setTimeout(r, 50)); }
  });
  await page.waitForTimeout(600);
  const r = await page.evaluate(() => {
    const anh = [...document.images];
    return {
      tong: anh.length,
      taiDuoc: anh.filter((a) => a.naturalWidth > 0).length,
      hong: anh.filter((a) => a.naturalWidth === 0).map((a) => (a.currentSrc || a.src).slice(-55)),
    };
  });
  console.log(url, JSON.stringify({ ...r, hong404 }));
  await page.close();
}
await browser.close();
