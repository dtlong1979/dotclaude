/* Vành focus: khai một lần ở `chung.css` theo `[data-qcv-type]` (cổng WCAG). */

/* ---------- khung hẹp: 320 px phải không tràn ngang (WCAG SC 1.4.10) ----------
   MẶC ĐỊNH của khối khi người dùng CHƯA chọn riêng cho điện thoại: đặt lại chính `--qcv-p-cols` ở đặc hiệu (0,1,0),
   nên quy tắc (0,2,0) của `chung.css` thắng khi người dùng đã chọn. */
@media (max-width: 1023px) { .eg--c-4, .eg--c-5, .eg--c-6, [data-qcv-r~="cols-4"], [data-qcv-r~="cols-5"], [data-qcv-r~="cols-6"] { --qcv-p-cols: 3; } }
@media (max-width: 767px) { .eg { --qcv-p-cols: 2; } .eg__inner { padding-left: calc(var(--space-unit) * 2); padding-right: calc(var(--space-unit) * 2); } }
@media (max-width: 479px) { .eg { --qcv-p-cols: 1; } .eg--k-circle { --qcv-p-cols: 2; } }
