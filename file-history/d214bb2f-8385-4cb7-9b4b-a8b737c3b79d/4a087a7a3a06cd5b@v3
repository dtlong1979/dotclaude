// Khối `footer` — ĐIỂM 4 (lượt hoàn thiện giao diện): « chân trang không tự cân đối khi không đủ nội dung ».
//
// BA CA, chọn bằng tham số thứ ba. Chân trang là SINGLETON của cả site nên một lượt chạy chỉ đo được MỘT
// trạng thái vùng — runner chép hiện vật tương ứng rồi gọi lại, cùng lối với hai biến thể `columns`/`minimal`.
//   `mot-cot`  `slots.cot` MỘT nhóm trong khi `props.cols` = "2" → lưới phải cho ĐÚNG MỘT cột (chiếm trọn).
//   `hai-cot`  `slots.cot` HAI nhóm trong khi `props.cols` = "4" → lưới phải cho ĐÚNG HAI cột, không phải bốn
//              cột với hai cột bỏ trống.
//   `bon-cot`  BỐN nhóm với `props.cols` = "4", đo ở 1000 px trên trang `kiem-footer-ro` (trang CÓ một khối
//              `entity-grid`) → phải ra ĐÚNG BỐN cột. Canh chuyện khác hẳn hai ca trên: CSS của khối KHÁC trên
//              cùng trang không được rò vào `--qcv-p-cols` của chân trang (xem chú thích ở nhánh dưới).
// Quy tắc chung của hai ca đầu: số cột KHÔNG BAO GIỜ vượt số nhóm thật — chặn trần, không nâng. Không có phép
// kiểm nào đòi chiều ngược lại (chọn ít cột hơn số nhóm là lựa chọn hợp lệ, nhóm thừa xuống dòng).
//
// Dùng: node tu-can-doi.mjs <ip-caddy> <thư-mục-kết-quả> [ca=mot-cot]
import { moKhung } from './khung-kiem.mjs';

const CA = process.argv[4] ?? 'mot-cot';
const PAGE = CA === 'bon-cot' ? 'kiem-footer-ro' : 'kiem-footer';
// 1000 px cho `bon-cot`: đúng khung 768–1023 nơi các khối lưới tự hạ 4 cột xuống 3 cho CHÍNH CHÚNG — ở 1280
// quy tắc ấy không chạy nên không đo được gì. Mỗi ca chạy đúng 5 phép kiểm; `toiThieu` là con số ấy, không thấp hơn.
const KHUNG = CA === 'bon-cot' ? 1000 : 1280;
const K = await moKhung({ ten: `footer/${CA}`, trang: PAGE, toiThieu: 5, khungNhin: [KHUNG] });
const { page, check, PUB, out } = K;

await page.setViewportSize({ width: KHUNG, height: 900 });
await page.goto(`${PUB}/${PAGE}`, { waitUntil: 'networkidle' });
await page.waitForSelector('.footer__cot', { timeout: 5000 }).catch(() => {});

const o = await page.evaluate(() => {
  const cot = document.querySelector('.footer__cot');
  const brand = document.querySelector('.footer__brand');
  const goc = document.querySelector('.footer');
  if (!cot || !brand) return null;
  const rCot = cot.getBoundingClientRect();
  const rBrand = brand.getBoundingClientRect();
  const css = [...document.querySelectorAll('link[rel="stylesheet"]')].map((l) => (l.getAttribute('href') ?? '').replace(/.*\//, '').replace(/\?.*/, ''));
  return {
    soMuc: cot.querySelectorAll('.footer__mot-cot').length,
    track: getComputedStyle(cot).gridTemplateColumns.trim().split(/\s+/).filter((t) => t !== '0px').length,
    // Số HÀNG thật của các nhóm (mốc trên khác nhau) — bốn nhóm trên bốn cột là một hàng; ba cột là hai hàng.
    hangNhom: new Set([...cot.children].map((c) => Math.round(c.getBoundingClientRect().top))).size,
    wCot: Math.round(rCot.width), wBrand: Math.round(rBrand.width),
    cols: goc?.getAttribute('data-qcv-r') ?? '',
    // Tệp CSS của khối lưới có nạp TRƯỚC `footer.css` không — đối chứng của ca `bon-cot`.
    egTruocFooter: css.indexOf('entity-grid.css') !== -1 && css.indexOf('entity-grid.css') < css.indexOf('footer.css'),
    // Giá trị THẬT SỰ tới nơi của prop `cols`. Không có dòng này thì phép kiểm « lưới cho 2 cột » xanh cả khi
    // prop bị kẹt ở 2 vì một lý do hoàn toàn khác — đúng chuyện đã xảy ra: `.footer { --qcv-p-cols: 2 }` của
    // khối thắng `[data-qcv-r~="cols-4"]` của `chung.css` do cùng đặc hiệu mà nạp sau, nên chọn 4 cột vẫn ra 2.
    bienCols: goc ? getComputedStyle(goc).getPropertyValue('--qcv-p-cols').trim() : '',
  };
});

// Ô TRỐNG BÊN PHẢI (2026-09-13). `.footer__inner` chia 1fr : 2fr. Cụm danh tính từng khai `grid-row: 1 / -1` với
// ý "cao hết mọi dòng", nhưng `-1` trỏ tới vạch cuối của lưới TƯỜNG MINH mà khối không khai `grid-template-rows`
// nào — lưới tường minh chỉ có một vạch, nên `1 / -1` thành `1 / 1`, tức MỘT dòng. Hệ quả đo được trên site mẫu:
// biểu mẫu rơi xuống **cột 1 dòng 2** và ô 800×141 px ở cột 2 dòng 2 bỏ TRỐNG.
//
// Đo HÌNH HỌC, không đọc lại `grid-column`: giá trị ấy nay do chính CSS của khối khai tường minh, nên đọc nó là
// phép kiểm tự soi gương — nó xanh vì tôi vừa viết dòng đó, không vì bố cục đúng. Toạ độ x thì không nói dối:
// mọi cụm ngoài danh tính phải đứng CÙNG MỘT mốc trái, và mốc ấy phải nằm BÊN PHẢI cụm danh tính.
const b = await page.evaluate(() => {
  const inner = document.querySelector('.footer__inner');
  if (!inner) return null;
  const hop = (e) => ({ ten: (e.className || '').toString().split(' ')[0], x: Math.round(e.getBoundingClientRect().x) });
  const con = [...inner.children].map(hop);
  const brand = con.find((c) => c.ten === 'footer__brand') ?? null;
  return { so: con.length, brand, conLai: con.filter((c) => c.ten !== 'footer__brand') };
});

const khongOTrong = () => {
  check(`${CA}-trong-a`, 'fixture đúng ý: cột phải có ĐỦ HAI cụm (liên kết + biểu mẫu) — đối chứng, vì với MỘT cụm thì lưới chỉ một dòng và phép kiểm sau xanh mà không chứng minh được gì',
    !!b && b.brand !== null && b.conLai.length >= 2, JSON.stringify(b));
  check(`${CA}-trong-b`, 'điểm 4 · KHÔNG cụm nào rơi ngược về cột trái để lại ô trống bên phải: mọi cụm ngoài danh tính cùng một mốc trái, và mốc ấy nằm BÊN PHẢI cụm danh tính',
    !!b && b.conLai.length > 0 && b.brand !== null
      && new Set(b.conLai.map((c) => c.x)).size === 1 && b.conLai[0].x > b.brand.x,
    JSON.stringify(b));
};

if (CA === 'bon-cot') {
  // RÒ TỪ KHỐI KHÁC (soát 2026-09-13). `cards`, `entity-grid`, `product-gallery`, `search-results` từng viết
  // `[data-qcv-r~="cols-4"] { --qcv-p-cols: 3 }` ở ≤1023 px KHÔNG neo vào gốc khối — selector ấy khớp MỌI phần
  // tử mang thuộc tính, kể cả gốc chân trang, và các tệp ấy nạp TRƯỚC `footer.css`. Khi chân trang còn
  // `.footer { --qcv-p-cols: 2 }` (nạp sau, cùng đặc hiệu) nó vô tình che chuyện này; gỡ dòng đó (QG4-67) là
  // rò lộ ra: cùng một chân trang `cols=4` đo 1000 px ra 4 cột trên `kiem-footer` (trang rỗng) nhưng 3 cột,
  // hai hàng trên trang có `entity-grid`. Chữa gốc bằng `:where(.eg)[data-qcv-r~=…]` ở từng khối. Phép kiểm
  // ngược: bỏ `:where(.eg)` ở `entity-grid/style.css` → `bienCols: "3"`, `track: 3`, 8b và 8c ĐỎ.
  check('8a', 'fixture đúng ý: BỐN nhóm, `props.cols` = "4", và trang nạp `entity-grid.css` TRƯỚC `footer.css` (đối chứng — thiếu khối lưới trên trang thì 8b/8c xanh mà không chứng minh được gì)',
    !!o && o.soMuc === 4 && o.cols.split(/\s+/).includes('cols-4') && o.egTruocFooter === true, JSON.stringify(o));
  check('8b', 'prop `cols` của chân trang KHÔNG phụ thuộc khối nào khác có mặt trên trang: `--qcv-p-cols` tính ra bằng 4 ở 1000 px dù `entity-grid.css` (tự hạ 4→3 ở ≤1023 px cho CHÍNH NÓ) nạp trước',
    !!o && o.bienCols === '4', JSON.stringify(o));
  check('8c', 'lưới `.footer__cot` cho ĐÚNG BỐN cột thật trên MỘT hàng (bằng số nhóm, không bị hạ xuống 3 cột hai hàng)',
    !!o && o.track === 4 && o.hangNhom === 1, JSON.stringify(o));
  khongOTrong();
} else if (CA === 'hai-cot') {
  check('6', 'fixture đúng ý: HAI nhóm liên kết và `props.cols` = "4" (đối chứng — nếu khác thì phép kiểm 7 không chứng minh được gì)',
    !!o && o.soMuc === 2 && o.cols.split(/\s+/).includes('cols-4'), JSON.stringify(o));
  // ĐỐI CHỨNG CHO PHÉP KIỂM 7, và là lưới an toàn của chính cơ chế: prop `cols` phải THẬT SỰ tới được phần tử.
  // Thiếu dòng này thì 7 xanh cả khi `--qcv-p-cols` kẹt ở 2 vì một lý do không liên quan — đúng chuyện đã xảy
  // ra và chỉ lộ ra khi phép kiểm ngược KHÔNG đỏ: bỏ hẳn quy tắc chặn trần mà lưới vẫn hai cột.
  check('6b', 'đối chứng · prop `cols` THẬT SỰ tới nơi: `--qcv-p-cols` tính ra bằng 4 (nếu nó kẹt ở 2 thì phép kiểm 7 xanh mà không chứng minh được gì)',
    !!o && o.bienCols === '4', JSON.stringify(o));
  check('7', 'điểm 4 · lưới `.footer__cot` cho ĐÚNG HAI cột thật (bằng SỐ NHÓM), không phải bốn cột với hai cột bỏ trống — số cột chặn trần theo số nhóm',
    !!o && o.track === 2, JSON.stringify(o));
  khongOTrong();
} else {
  check('1', 'fixture đúng ý: CHỈ MỘT nhóm liên kết trong `.footer__cot` (đối chứng — nếu khác 1 thì hai phép kiểm dưới không chứng minh được gì)',
    !!o && o.soMuc === 1, JSON.stringify(o));
  check('2', 'điểm 4 · lưới `.footer__cot` cho ĐÚNG MỘT cột thật (không phải hai cột với một cột bỏ trống) dù `props.cols` = "2"',
    !!o && o.track === 1, JSON.stringify(o));
  // `.footer__inner` chia 1fr (cụm danh tính) : 2fr (phần còn lại) — `.footer__cot` tự cân đối đúng thì rộng gấp
  // khoảng ĐÔI cụm danh tính (2/1), không phải rộng bằng NỬA phần dành cho nó (tức chỉ bằng cụm danh tính).
  check('3', 'điểm 4 · cột liên kết duy nhất chiếm TRỌN bề rộng phần 2fr dành cho nó (rộng hơn RÕ RỆT cụm danh tính 1fr, không co lại còn nửa bề rộng)',
    !!o && o.wCot >= o.wBrand * 1.5, JSON.stringify(o));
  khongOTrong();
}

await page.screenshot({ path: `${out}/${CA}-${KHUNG}.png` });
await K.ketThuc();
