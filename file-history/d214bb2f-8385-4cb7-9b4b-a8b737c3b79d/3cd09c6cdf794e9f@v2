// 172 px cuối trang: của ai? Liệt kê từng tầng bọc và hộp của nó, cùng mọi phần tử `fixed`.
import { chromium } from 'playwright-core';
const [ip] = process.argv.slice(2);
const browser = await chromium.launch({
  executablePath: '/usr/bin/chromium-browser',
  args: [`--host-resolver-rules=MAP qcv2-mau.localhost ${ip}`, '--no-sandbox', '--disable-gpu'],
});
const page = await browser.newPage({ viewport: { width: 1280, height: 900 }, locale: 'vi-VN' });
await page.goto('http://qcv2-mau.localhost:8081/bo-suu-tap', { waitUntil: 'networkidle' });
const r = await page.evaluate(() => {
  const ten = (e) => `${e.tagName}${e.id ? '#' + e.id : ''}.${(e.className || '').toString().slice(0, 40)}`;
  const hop = (e) => { const b = e.getBoundingClientRect(); const s = getComputedStyle(e);
    return { ten: ten(e), top: Math.round(b.top + scrollY), bottom: Math.round(b.bottom + scrollY), h: Math.round(b.height),
      pos: s.position, mb: s.marginBottom, pb: s.paddingBottom, minH: s.minHeight, disp: s.display }; };
  const tang = [];
  let e = document.querySelector('.footer') || document.querySelector('footer');
  while (e && e !== document.documentElement) { tang.push(hop(e)); e = e.parentElement; }
  tang.push(hop(document.documentElement));
  const fixed = [...document.body.querySelectorAll('*')].filter((x) => {
    const s = getComputedStyle(x); return s.position === 'fixed' || s.position === 'sticky'; }).map(hop);
  // Con trực tiếp của body
  const conBody = [...document.body.children].map(hop);
  return { scrollHeight: document.documentElement.scrollHeight, tangBocChanTrang: tang, conBody, fixed };
});
console.log(JSON.stringify(r, null, 1));
await browser.close();
