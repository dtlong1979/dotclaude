// ===== 9. ĐIỂM 3 — hiệu ứng khi rê chuột, KHÔNG được đổi hình học của ngăn xếp (luật 3c đo trên chính hộp này) ====
{
  await page.setViewportSize({ width: 1280, height: 900 });
  await page.goto(`${PUB}/${PAGE}`, { waitUntil: 'networkidle' });
  const nut = page.locator('.contact-bar__nut').first();
  const truoc = await page.evaluate(() => getComputedStyle(document.querySelector('.contact-bar__nut')).filter);
  const hopTruoc = await nut.boundingBox();
  await nut.hover();
  await page.waitForTimeout(250);
  const dang = await page.evaluate(() => getComputedStyle(document.querySelector('.contact-bar__nut:hover')).filter);
  const hopDang = await nut.boundingBox();
  check('9a', 'điểm 3 · TRƯỚC khi rê, nút không có `filter`', truoc === 'none', truoc);
  check('9b', 'điểm 3 · ĐANG rê chuột, nút sáng lên (`filter: brightness(…)`) — đo SAU khi chủ động di chuột', dang !== 'none' && dang !== truoc, dang);
  check('9c', 'điểm 3 · CỐ Ý dùng `filter`, không `transform`: hộp nút KHÔNG đổi kích thước/toạ độ lúc rê — ngăn xếp nổi có trần hình học (luật 3c) đo đúng lúc người dùng đang rê chuột',
    Math.abs(hopDang.width - hopTruoc.width) < 0.5 && Math.abs(hopDang.height - hopTruoc.height) < 0.5 && Math.abs(hopDang.x - hopTruoc.x) < 0.5 && Math.abs(hopDang.y - hopTruoc.y) < 0.5,
    `${JSON.stringify(hopTruoc)} -> ${JSON.stringify(hopDang)}`);
  await page.mouse.move(hopTruoc.x - 60, hopTruoc.y - 60);
  await page.emulateMedia({ reducedMotion: 'reduce' });
  await page.waitForTimeout(100);
  await nut.hover();
  await page.waitForTimeout(250);
  const coHover = await page.evaluate(() => !!document.querySelector('.contact-bar__nut:hover'));
  const dangReduced = coHover ? await page.evaluate(() => getComputedStyle(document.querySelector('.contact-bar__nut:hover')).transitionDuration) : '(không bắt được :hover)';
  check('9d', 'điểm 3 · NGƯỢC · `prefers-reduced-motion: reduce` → không còn hiệu ứng chuyển động (`transition-duration: 0s`)',
    coHover && dangReduced === '0s', dangReduced);
  await page.emulateMedia({ reducedMotion: 'no-preference' });
}

await K.ketThuc();
