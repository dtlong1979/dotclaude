LOG   = BASE + "/templates/log.html"
CSS   = BASE + "/static/style.css"

def patch(path, edits, marker):
    src = io.open(path, encoding="utf-8").read()
    if marker in src:
        print("SKIP (da vá):", path.split("/")[-1]); return True
    for i,(o,n) in enumerate(edits):
        c = src.count(o)
        if c != 1:
            print("MISS %s edit %d: khop %d -> DUNG." % (path.split("/")[-1], i, c)); return False
    bak = path + ".bak_mucmin_" + time.strftime("%Y%m%d_%H%M%S")
    io.open(bak, "w", encoding="utf-8").write(src)
    for o,n in edits: src = src.replace(o, n)
    io.open(path, "w", encoding="utf-8").write(src)
    print("OK:", path.split("/")[-1], "| backup", bak.split("/")[-1]); return True

