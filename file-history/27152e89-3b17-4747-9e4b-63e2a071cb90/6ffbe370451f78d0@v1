function cleanText(value: FormDataEntryValue | null, maxLength: number) {
  return String(value ?? "").trim().slice(0, maxLength);
}

function cleanList(value: FormDataEntryValue | null, maxItems: number) {
  return cleanText(value, 2000)
    .split(/\n+/)
    .map((item) => item.trim())
    .filter(Boolean)
    .slice(0, maxItems);
}

function avatarIdFromUser(user: Pick<UserRow, "avatar">) {
  if (!user.avatar) return "";
  return typeof user.avatar === "string" ? user.avatar : user.avatar.id ?? "";
}

function directusAssetUrl(fileId: string) {
  return fileId ? `/api/fithou-auth/avatar-image/${encodeURIComponent(fileId)}` : "";
}

async function uploadPresetAvatar(preset: string, name: string, token: string) {
  const palettes: Record<string, [string, string]> = {
    ocean: ["#0ea5e9", "#075985"],
    emerald: ["#10b981", "#0f766e"],
    violet: ["#8b5cf6", "#5b21b6"],
    amber: ["#f59e0b", "#b45309"]
  };
  const [from, to] = palettes[preset] ?? palettes.ocean;
  const initials =
    name
      .split(/\s+/)
      .filter(Boolean)
      .slice(-2)
      .map((part) => part[0]?.toUpperCase())
      .join("") || "F";
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256"><defs><linearGradient id="g" x1="0" x2="1" y1="0" y2="1"><stop stop-color="${from}"/><stop offset="1" stop-color="${to}"/></linearGradient></defs><rect width="256" height="256" rx="64" fill="url(#g)"/><text x="128" y="145" text-anchor="middle" dominant-baseline="middle" font-family="Arial, sans-serif" font-size="82" font-weight="800" fill="#fff">${escapeXml(initials)}</text></svg>`;
  return directusUploadFile(`fithou-avatar-${preset}-${Date.now()}.svg`, "image/svg+xml", Uint8Array.from(Buffer.from(svg, "utf8")), token);
}

function escapeXml(value: string) {
  return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function boundedNumber(value: FormDataEntryValue | null, min: number, max: number, fallback: number) {
  const parsed = Number(value);
  if (!Number.isFinite(parsed)) return fallback;
  return Math.min(max, Math.max(min, Math.round(parsed)));
}

function colorValue(value: FormDataEntryValue | null, fallback: string) {
  const color = cleanText(value, 20);
  return /^#[0-9a-fA-F]{6}$/.test(color) ? color : fallback;
}

function normalizeSection(value: string) {
  if (value === "all") return "all";
  const found = legacySections.find((section) => section.key === value);
  return (found?.key ?? "announcements") as LegacySectionKey | "all";
}

function normalizeSections(values: FormDataEntryValue[]) {
  return values
    .map((value) => normalizeSection(String(value)))
    .filter((value): value is LegacySectionKey => value !== "all");
}

function roleKind(name: string): "system_admin" | "content_admin" | "publisher" | "editor" | "contributor" {
  const normalized = name.toLowerCase();
  if (normalized.includes("system_admin") || normalized.includes("system admin") || normalized.includes("administrator") || normalized.includes("hệ thống")) return "system_admin";
  // Gộp "Publisher / chuyên trang" vào "Quản trị nội dung" (content_admin) — cùng quyền đăng+duyệt, đều chọn được chuyên mục.
  if (
    normalized.includes("content_admin") || normalized.includes("content admin") || normalized.includes("quản trị nội dung") ||
    normalized.includes("publisher") || normalized.includes("chuyên trang") || normalized.includes("duyệt")
  ) return "content_admin";
  if (normalized.includes("editor") || normalized.includes("biên")) return "editor";
  return "contributor";
}

function displayRoleName(name: string) {
  const normalized = name.toLowerCase();
  if (normalized.includes("administrator") || normalized.includes("system admin")) return "Quản trị viên hệ thống";
  if (normalized.includes("content admin") || normalized.includes("publisher") || normalized.includes("chuyên trang")) return "Quản trị nội dung";
  if (normalized.includes("editor")) return "Biên tập viên";
  return name;
}

function scopePermissions(kind: ReturnType<typeof roleKind>) {
  if (kind === "system_admin" || kind === "content_admin" || kind === "publisher") {
    return { canCreate: true, canReview: true, canPublish: true };
  }

  return { canCreate: true, canReview: false, canPublish: false };
}

function slugKey(value: string) {
  return value
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80);
}

function permissionLevelFromForm(formData: FormData) {
  const text = Array.from(formData.values()).join(" ").toLowerCase();
  if (text.includes("xóa") || text.includes("user") || text.includes("pagebuilder")) return "admin";
  if (text.includes("xuất bản") || text.includes("duyệt")) return "publisher";
  return "editor";
}

function removeUndefined(body: Record<string, unknown>) {
  return Object.fromEntries(Object.entries(body).filter(([, value]) => value !== undefined));
}

