async function applyRolePermissions(policyId: string, level: "admin" | "publisher" | "editor") {
  const token = await login();
  const collections = ["legacy_articles", "fithou_page_blocks", "fithou_content_sections", "site_settings", "theme_presets"];
  const actions = level === "admin" ? ["create", "read", "update", "delete"] : level === "publisher" ? ["create", "read", "update"] : ["create", "read"];

  for (const collection of collections) {
    for (const action of actions) {
      await ensurePermission(policyId, collection, action, token);
    }
  }
}

async function ensurePermission(policyId: string, collection: string, action: string, token: string) {
  const existing = await directusGet<Array<{ id?: number }>>(
    `/permissions?filter[policy][_eq]=${policyId}&filter[collection][_eq]=${collection}&filter[action][_eq]=${action}&fields=id&limit=1`,
    token
  );
  const body = { policy: policyId, collection, action, permissions: {}, fields: ["*"] };
  if (existing[0]?.id) {
    await directusPatch(`/permissions/${existing[0].id}`, body, token);
    return;
  }
  await directusPost("/permissions", body, token);
}

async function upsertAuthorScope(userId: string, section: LegacySectionKey, token: string, canCreate: boolean, canReview: boolean, canPublish: boolean) {
  const rows = await directusGet<Array<{ id?: number }>>(
    `/items/fithou_author_scopes?filter[user_id][_eq]=${encodeURIComponent(userId)}&filter[section_key][_eq]=${encodeURIComponent(section)}&fields=id&limit=1`,
    token
  );
  const body = { user_id: userId, section_key: section, can_create: canCreate, can_review: canReview, can_publish: canPublish };
  if (rows[0]?.id) {
    await directusPatch(`/items/fithou_author_scopes/${rows[0].id}`, body, token);
    return;
  }
  await directusPost("/items/fithou_author_scopes", body, token);
}

async function replaceAuthorScopes(
  userId: string,
  sections: LegacySectionKey[],
  token: string,
  permissions: { canCreate: boolean; canReview: boolean; canPublish: boolean }
) {
  const rows = await directusGet<Array<{ id?: number }>>(
    `/items/fithou_author_scopes?filter[user_id][_eq]=${encodeURIComponent(userId)}&fields=id&limit=5000`,
    token
  ).catch(() => []);

  for (const row of rows) {
    if (row.id) {
      await directusDelete(`/items/fithou_author_scopes/${row.id}`, token);
    }
  }

  for (const section of Array.from(new Set(sections))) {
    await upsertAuthorScope(userId, section, token, permissions.canCreate, permissions.canReview, permissions.canPublish);
  }
}

