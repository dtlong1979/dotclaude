}

async function login() {
  if (!directusUrl || !adminEmail || !adminPassword) {
    throw new Error("FithouOne chưa được cấu hình kết nối dữ liệu");
  }

  const response = await fetch(`${directusUrl}/auth/login`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ email: adminEmail, password: adminPassword })
  });

  if (!response.ok) {
    throw new Error(`Không đăng nhập được tài khoản quản trị dữ liệu: ${response.status}`);
  }

  return ((await response.json()) as DirectusResponse<{ access_token: string }>).data.access_token;
}

async function directusGet<T>(path: string, token: string) {
  const response = await fetch(`${directusUrl}${path}`, {
    headers: { Authorization: `Bearer ${token}` },
    cache: "no-store"
  });

  if (!response.ok) {
    throw new Error(`Yêu cầu đọc dữ liệu thất bại: ${response.status} ${await response.text()}`);
  }

  return ((await response.json()) as DirectusResponse<T>).data;
}

async function directusPost<T>(path: string, body: unknown, token: string) {
  const response = await fetch(`${directusUrl}${path}`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(body)
  });

  if (!response.ok) {
    throw new Error(`Yêu cầu tạo dữ liệu thất bại: ${response.status} ${await response.text()}`);
  }

  const text = await response.text();
  return text ? ((JSON.parse(text) as DirectusResponse<T>).data as T) : ({} as T);
}

async function directusPatch<T = unknown>(path: string, body: Record<string, unknown>, token: string) {
  const response = await fetch(`${directusUrl}${path}`, {
    method: "PATCH",
    headers: {
      Authorization: `Bearer ${token}`,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(removeUndefined(body))
  });

  if (!response.ok) {
    throw new Error(`Yêu cầu cập nhật dữ liệu thất bại: ${response.status} ${await response.text()}`);
  }

  const text = await response.text();
  return text ? ((JSON.parse(text) as DirectusResponse<T>).data as T) : ({} as T);
}

async function directusUploadFile(fileName: string, mimeType: string, bytes: Uint8Array, token: string) {
  const form = new FormData();
  form.append("file", new Blob([bytes], { type: mimeType }), fileName);
  form.append("title", fileName);

  const response = await fetch(`${directusUrl}/files`, {
    method: "POST",
    headers: { Authorization: `Bearer ${token}` },
    body: form
  });

  if (!response.ok) {
    throw new Error(`Upload avatar thất bại: ${response.status} ${await response.text()}`);
  }

  return ((await response.json()) as DirectusResponse<{ id: string }>).data.id;
}

async function directusDelete(path: string, token: string) {
  const response = await fetch(`${directusUrl}${path}`, {
    method: "DELETE",
    headers: { Authorization: `Bearer ${token}` }
  });

  if (!response.ok) {
    throw new Error(`Yêu cầu xóa dữ liệu thất bại: ${response.status} ${await response.text()}`);
  }
}

