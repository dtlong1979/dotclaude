export async function getAdvancedAdminData() {
  const [roles, users, sections, blocks] = await Promise.all([
    listRoles().catch(() => fallbackRoles()),
    listUsers().catch(() => []),
    listSections().catch(() => fallbackSections()),
    listHomeBlocks().catch(() => [])
  ]);

  return { roles, users, sections, blocks };
}

export async function createAdvancedRole(formData: FormData) {
  const name = cleanText(formData.get("roleName"), 120);
  const description = cleanText(formData.get("roleDescription"), 300);

  if (!name) {
    throw new Error("Tên role không được để trống");
  }

  const token = await login();
  const role = await ensureRole(name, description || "Role được tạo từ FithouOne");
  const policy = await ensurePolicy(`${name} Policy`, description || "Phân quyền FithouOne", true);
  await ensureAccess(role.id, policy.id);
  await applyRolePermissions(policy.id, permissionLevelFromForm(formData));
  revalidateAdmin();
}

function roleNameOf(row: { role?: unknown } | null | undefined): string {
  const r = (row?.role ?? "") as { name?: string } | string;
  return typeof r === "object" && r ? String(r.name ?? "") : String(r ?? "");
}

// Chặn thao tác gỡ/khóa/xóa quản trị hệ thống (system_admin) cuối cùng.
async function ensureNotLastSystemAdmin(userId: string, token: string, verb: string) {
  const target = await directusGet<UserRow>(`/users/${encodeURIComponent(userId)}?fields=role.name`, token).catch(() => null);
  if (roleKind(roleNameOf(target)) !== "system_admin") return;
  const admins = await directusGet<UserRow[]>(
    "/users?fields=id,status,role.name&filter[status][_eq]=active&limit=200", token
  ).catch(() => [] as UserRow[]);
  const count = admins.filter((u) => roleKind(roleNameOf(u)) === "system_admin").length;
  if (count <= 1) {
    throw new Error(`Không thể ${verb} quản trị hệ thống (system_admin) cuối cùng.`);
  }
}

export async function assignAdvancedUserRole(formData: FormData, actorId?: string) {
  const userId = String(formData.get("userId") ?? "");
  const roleId = String(formData.get("roleId") ?? "");

  if (!userId || !roleId) {
    throw new Error("Cần chọn user và role");
  }

  const token = await login();
  const role = await getRoleById(roleId, token);
  const kind = roleKind(role?.name ?? roleId);

  if (kind !== "system_admin") {                 // hạ quyền: chốt an toàn
    if (actorId && userId === actorId) {
      throw new Error("Không thể tự đổi role của chính mình");
    }
    await ensureNotLastSystemAdmin(userId, token, "đổi role của");
  }
  const selectedSections = normalizeSections(formData.getAll("sections"));
  // explicit = form sửa từng user: TÔN TRỌNG đúng ô đã tick, KHÔNG tự đổ về full khi bỏ bớt.
  const explicit = String(formData.get("sectionsMode") ?? "") === "explicit";
  // system_admin: toàn quyền, không cần scope. Còn lại (content_admin/editor) đều CHỌN được chuyên mục;
  // không tick gì (và không phải explicit) = mặc định toàn bộ chuyên mục.
  const sections =
    kind === "system_admin"
      ? []
      : explicit
        ? selectedSections
        : selectedSections.length
          ? selectedSections
          : legacySections.map((section) => section.key);

  // Cho phép 0 chuyên mục khi chọn có chủ đích (explicit) — vd tài khoản chỉ quản lý Gallery.
  if (!explicit && kind !== "system_admin" && !sections.length) {
    throw new Error("Cần chọn ít nhất một chuyên mục cho role này");
  }

  await directusPatch(`/users/${encodeURIComponent(userId)}`, { role: roleId }, token);
  await replaceAuthorScopes(userId, sections, token, scopePermissions(kind));

  revalidateAdmin();
}

export async function createAdvancedUser(formData: FormData) {
  const email = cleanText(formData.get("email"), 160);
  const password = cleanText(formData.get("password"), 120);
  const firstName = cleanText(formData.get("firstName"), 80);
  const lastName = cleanText(formData.get("lastName"), 80);
  const title = cleanText(formData.get("title"), 120);
  const location = cleanText(formData.get("location"), 120);
  const description = cleanText(formData.get("description"), 600);
  const avatarPreset = cleanText(formData.get("avatarPreset"), 40) || "ocean";
  const roleId = String(formData.get("roleId") ?? "");
  const selectedSections = normalizeSections(formData.getAll("sections"));

  if (!email || !password || !roleId) {
    throw new Error("Cần nhập email, mật khẩu ban đầu và role");
  }

  const token = await login();
  const role = await getRoleById(roleId, token);
  const kind = roleKind(role?.name ?? roleId);
  const avatar = await uploadPresetAvatar(avatarPreset, [firstName, lastName].filter(Boolean).join(" ") || email, token).catch(() => "");
  const sections =
    kind === "system_admin"
      ? []
      : selectedSections.length
        ? selectedSections
        : legacySections.map((section) => section.key);
  const created = await directusPost<UserRow>(
    "/users",
    {
      email,
      password,
      first_name: firstName,
      last_name: lastName,
      title,
      location,
      description,
      avatar: avatar || undefined,
      role: roleId,
      status: "active"
    },
    token
  );

  if (created.id && kind !== "system_admin") {
    await replaceAuthorScopes(created.id, sections, token, scopePermissions(kind));
  }

  revalidateAdmin();
}

