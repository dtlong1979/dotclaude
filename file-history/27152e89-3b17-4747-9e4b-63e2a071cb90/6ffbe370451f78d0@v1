export async function deleteAdvancedCategoryWithMove(formData: FormData) {
  const fromCategory = normalizeSection(String(formData.get("fromCategory") ?? ""));
  const toCategory = normalizeSection(String(formData.get("toCategory") ?? ""));

  if (fromCategory === "all" || toCategory === "all" || fromCategory === toCategory) {
    throw new Error("Cần chọn category nguồn và category đích khác nhau");
  }

  const token = await login();
  const target = legacySections.find((section) => section.key === toCategory);
  const rows = await directusGet<Array<{ id?: number }>>(
    `/items/legacy_articles?filter[category_key][_eq]=${encodeURIComponent(fromCategory)}&fields=id&limit=5000`,
    token
  );

  for (const row of rows) {
    if (row.id) {
      await directusPatch(
        `/items/legacy_articles/${row.id}`,
        {
          category_key: toCategory,
          category_name: target?.categories[0] ?? target?.title ?? toCategory
        },
        token
      );
    }
  }

  await disableSection(fromCategory, token);
  revalidateAdmin();
}

