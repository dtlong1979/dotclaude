async function listUsers() {
  const token = await login();
  const [rows, scopes] = await Promise.all([
    directusGet<UserRow[]>("/users?fields=id,email,first_name,last_name,title,location,description,avatar,status,can_manage_albums,can_manage_faq,can_manage_signage,role.id,role.name&sort=email&limit=200", token),
    directusGet<ScopeRow[]>("/items/fithou_author_scopes?fields=user_id,section_key&limit=5000", token).catch(() => [])
  ]);
  const scopesByUser = new Map<string, string[]>();

  for (const scope of scopes) {
    if (!scope.user_id || !scope.section_key) continue;
    scopesByUser.set(scope.user_id, [...(scopesByUser.get(scope.user_id) ?? []), scope.section_key]);
  }

  return rows
    .filter((user) => user.id && user.email)
    .map((user) => ({
      id: user.id ?? "",
      email: user.email ?? "",
      name: [user.first_name, user.last_name].filter(Boolean).join(" ") || user.email || "",
      firstName: user.first_name ?? "",
      lastName: user.last_name ?? "",
      title: user.title ?? "",
      location: user.location ?? "",
      description: user.description ?? "",
      avatarUrl: directusAssetUrl(avatarIdFromUser(user)),
      status: user.status ?? "",
      roleId: typeof user.role === "object" ? user.role?.id ?? "" : String(user.role ?? ""),
      roleName: typeof user.role === "object" ? displayRoleName(user.role?.name ?? "") : "",
      sections: scopesByUser.get(user.id ?? "") ?? [],
      canManageAlbums: Boolean(user.can_manage_albums),
      canManageFaq: Boolean(user.can_manage_faq),
      canManageSignage: Boolean(user.can_manage_signage)
    }));
}

